# Copy this file to .env and fill in real values. Never commit .env.

# LinkedIn session cookie, obtained by logging into linkedin.com in a real
# browser and copying it from DevTools > Application > Cookies. See
# README.md "Getting your LinkedIn session cookie". Only li_at is needed —
# JSESSIONID is deliberately NOT configured here; this app obtains its own
# fresh one via an anonymous warm-up request. See README "How it works".
LI_AT_COOKIE=

# Clients of this API must send this value in the X-API-Key header.
# Generate one yourself, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Which browser's TLS/JA3 fingerprint curl_cffi impersonates for every
# LinkedIn request. "chrome" tracks curl_cffi's current default; pin to a
# specific version (e.g. "chrome124") if you need reproducibility across
# a curl_cffi upgrade. See README Known Limitations.
IMPERSONATE_BROWSER=chrome

# Optional tuning (defaults shown)

# Outbound requests to LinkedIn are spaced by a random interval drawn from
# [MIN, MAX] rather than a fixed delay — jittered pacing is closer to how a
# human browses than perfectly even spacing.
MIN_REQUEST_INTERVAL_SECONDS=3.0
MAX_REQUEST_INTERVAL_SECONDS=8.0

# Safety ceiling on LinkedIn-bound requests per rolling UTC day, regardless
# of how many API keys/callers are driving this instance. 0 disables it.
DAILY_REQUEST_LIMIT=300

CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=512

# Timeout for each direct HTTP request to LinkedIn. Requests here are
# lightweight (no browser rendering), so this can be much lower than a
# browser-based scraper would need — mainly a safety net against a hung
# connection, not something that needs tuning around platform proxy
# timeouts.
REQUEST_TIMEOUT_SECONDS=15.0
