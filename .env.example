# Copy this file to .env and fill in real values. Never commit .env.

# LinkedIn session cookies, obtained by logging into linkedin.com in a real
# browser and copying them from DevTools > Application > Cookies. See
# README.md "Getting LinkedIn session cookies".
LI_AT_COOKIE=
JSESSIONID_COOKIE=

# Clients of this API must send this value in the X-API-Key header.
# Generate one yourself, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Optional tuning (defaults shown)
MIN_REQUEST_INTERVAL_SECONDS=3.0
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=512
REQUEST_TIMEOUT_SECONDS=20.0
